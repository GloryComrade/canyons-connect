# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Canyons Connect — secrets & local config (NEVER commit these)
# ---------------------------------------------------------------------------
# Environment / secret files for local tooling
*.env
.env.*
env.json
env.*.json
config/secrets*.json
**/*.secret

# Firebase — local state, build output, and non-committed platform config
.firebase/
firebase-debug.log
firestore-debug.log
*-debug.log
firebase/functions/node_modules/
firebase/functions/lib/
firebase/functions/.env
# Google platform config is regenerated by `flutterfire configure`
**/google-services.json
**/GoogleService-Info.plist
lib/firebase_options.g.dart

# Deprecated Flutter plugin registries
.flutter-plugins

# Harness scratch (cwd restore marker)
testing/

# Gradle / Android build output
/android/build/
/android/.gradle/
