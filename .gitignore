**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Canyons Connect — secrets & local config (NEVER commit these)
# ---------------------------------------------------------------------------
# Environment / secret files for dart-define-from-file and local tooling
*.env
.env.*
env.json
env.*.json
config/secrets*.json
# Supabase keys / OAuth client secrets / service-role keys must never land here
**/service_role*.txt
**/*.secret

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
supabase/.env
.supabase/

# Deprecated Flutter plugin registries
.flutter-plugins

# Harness scratch (cwd restore marker)
testing/
