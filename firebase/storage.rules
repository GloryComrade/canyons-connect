rules_version = '2';

// Canyons Connect — Storage rules for Photo Drop.
// Storage rules can't query Firestore, so participation is enforced at the
// Firestore `photos` document level; here we require an authenticated user and
// confine writes to the photo-drops/ prefix. Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /photo-drops/{eventId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
