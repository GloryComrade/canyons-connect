# Canyons Connect — Cloud Functions config (TEMPLATE)
# Copy to firebase/functions/.env (gitignored). firebase-functions loads .env
# automatically at deploy. For true secrets, prefer:
#   firebase functions:secrets:set CANVAS_CLIENT_SECRET
# NEVER commit real values. (Firebase client config in firebase_options.dart is
# public by design and is NOT a secret.)

# 32-byte base64 key for AES-GCM credential encryption:  openssl rand -base64 32
CREDENTIALS_ENC_KEY=
# Random secret for signing OAuth state params:          openssl rand -hex 32
STATE_SIGNING_SECRET=
# Shared secret for the seed endpoint:                    openssl rand -hex 32
SEED_SECRET=
# Where oauthCallback deep-links back to after linking:
APP_OAUTH_RETURN_URL=canyonsconnect://login-callback
# Base URL of your deployed functions (region-project), e.g.
#   https://us-central1-<project-id>.cloudfunctions.net
FUNCTIONS_BASE_URL=

# --- Canvas (district Canvas admin developer key) ---
CANVAS_BASE_URL=https://canyons.instructure.com
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_WEBHOOK_SECRET=

# --- GroupMe ---
GROUPME_CLIENT_ID=
GROUPME_CLIENT_SECRET=

# --- Skyward / ManageBac (if APIs available) ---
SKYWARD_API_BASE=
SKYWARD_API_KEY=
# Set to 1 to load demo schedule/grades when API base is missing or fails:
SKYWARD_SYNC_FIXTURE=1
MANAGEBAC_API_BASE=
MANAGEBAC_API_TOKEN=
