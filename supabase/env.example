# Canyons Connect — Edge Function secrets (TEMPLATE)
# Copy to supabase/.env (gitignored) and fill in, then push with:
#   supabase secrets set --env-file supabase/.env
# NEVER commit real values. The anon/publishable key is the only value that
# ships in the client (via --dart-define); everything below is server-only.

# --- Supabase (auto-available in deployed functions; set for local dev) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption + signing ---
# 32-byte base64 key for AES-GCM credential encryption:
#   openssl rand -base64 32
CREDENTIALS_ENC_KEY=
# Random secret for signing OAuth state params:
#   openssl rand -hex 32
STATE_SIGNING_SECRET=
# Shared secret the cron scheduler sends as x-cron-secret:
CRON_SECRET=

# Where oauth-callback deep-links back to after linking:
APP_OAUTH_RETURN_URL=canyonsconnect://login-callback

# --- Canvas (district Canvas admin issues the developer key) ---
CANVAS_BASE_URL=https://canyons.instructure.com
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_WEBHOOK_SECRET=

# --- GroupMe (developers.groupme.com application) ---
GROUPME_CLIENT_ID=
GROUPME_CLIENT_SECRET=

# --- Skyward (district-granted API, if available) ---
SKYWARD_API_BASE=
SKYWARD_API_KEY=

# --- ManageBac (if the school plan exposes an API) ---
MANAGEBAC_API_BASE=
MANAGEBAC_API_TOKEN=
